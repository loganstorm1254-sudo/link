# Local only — never commit real secrets
SESSION_SECRET=change-me-to-a-long-random-string

# REQUIRED on Vercel if more than one person logs in (durable login):
CONSOLE_USERNAME=logan
CONSOLE_PASSWORD=pick-a-shared-password

# Optional emergency reclaim
CONSOLE_RESET_SECRET=optional-reset-password

# Optional but recommended so LOGS survive across serverless instances.
# Free: https://upstash.com → Redis → REST URL + token
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
