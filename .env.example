# Local only — never commit real secrets
SESSION_SECRET=change-me-to-a-long-random-string
CONSOLE_RESET_SECRET=optional-reset-password

# Optional but recommended on Vercel so logs survive across serverless instances.
# Free: https://upstash.com → Redis → REST URL + token
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
